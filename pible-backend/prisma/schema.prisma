generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  displayName  String?   @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  apiKeys      ApiKey[]
  projects     Project[]
  providers    UserProvider[]
  avatarHistory AvatarHistory[]

  @@map("users")
}

model UserProvider {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  provider         String
  providerAccountId String    @map("provider_account_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_providers")
}

model AvatarHistory {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  avatarUrl   String    @map("avatar_url")
  provider    String    @default("upload")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("avatar_history")
}

model Project {
  id                String             @id @default(cuid())
  ownerId           String             @map("owner_id")
  name              String
  slug              String             @unique
  description       String?
  buildCommand      String?            @map("build_command")
  testCommand       String?            @map("test_command")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  agentProfiles     AgentProfile[]
  apiKeys           ApiKey[]
  architectureNotes ArchitectureNote[]
  decisions         Decision[]
  knownIssues       KnownIssue[]
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks             Task[]

  @@map("projects")
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String    @map("project_id")
  userId     String    @map("user_id")
  keyHash    String    @unique @map("key_hash")
  label      String?
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([keyHash])
  @@map("api_keys")
}

model AgentProfile {
  id            String             @id @default(cuid())
  projectId     String             @map("project_id")
  name          String
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  accessPattern AgentAccessPattern @default(cli_direct) @map("access_pattern")
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskRuns      TaskRun[]

  @@unique([projectId, name])
  @@map("agent_profiles")
}

model Task {
  id           String       @id @default(cuid())
  projectId    String       @map("project_id")
  title        String
  description  String?
  status       TaskStatus   @default(todo)
  priority     TaskPriority @default(medium)
  relatedFiles String[]     @map("related_files")
  dependencies String[]
  blockedBy    String?      @map("blocked_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  taskRuns     TaskRun[]
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, priority])
  @@map("tasks")
}

model TaskRun {
  id                 String             @id @default(cuid())
  taskId             String             @map("task_id")
  agentProfileId     String?            @map("agent_profile_id")
  actorType          ActorType          @map("actor_type")
  actorId            String             @map("actor_id")
  summary            String?
  diffStat           String?            @map("diff_stat")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  verificationOutput String?            @map("verification_output")
  humanApproved      Boolean?           @map("human_approved")
  createdAt          DateTime           @default(now()) @map("created_at")
  agentProfile       AgentProfile?      @relation(fields: [agentProfileId], references: [id])
  task               Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([agentProfileId])
  @@map("task_runs")
}

model Decision {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  title     String
  context   String
  decision  String
  rationale String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("decisions")
}

model ArchitectureNote {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  title        String
  content      String
  relatedFiles String[] @map("related_files")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("architecture_notes")
}

model KnownIssue {
  id           String      @id @default(cuid())
  projectId    String      @map("project_id")
  title        String
  description  String
  status       IssueStatus @default(open)
  relatedFiles String[]    @map("related_files")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("known_issues")
}

enum TaskStatus {
  todo
  in_progress
  completed
  blocked
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum ActorType {
  human
  agent
}

enum VerificationStatus {
  pending
  verified
  unverified
  skipped
}

enum IssueStatus {
  open
  resolved
  wont_fix
}

enum AgentAccessPattern {
  cli_direct
  web_chat
}
