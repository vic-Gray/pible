# ─── Database ──────────────────────────────────────────────────────────────────
# Transaction-mode pooler — used by the app at runtime (port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used by Prisma migrations / db push (port 6543)
# Required because pgbouncer transaction mode doesn't support DDL statements
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com/postgres"

# ─── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Salt rounds / secret used when hashing API keys before storage
API_KEY_HASH_SALT=

# ─── App ────────────────────────────────────────────────────────────────────────
PORT=3001
ENABLE_SWAGGER=true
API_NAME=Pible API
API_DESCRIPTION=Pible Backend API Documentation
API_VERSION=1.0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
